+/* ------------------------------------------------------------------
+   FOUNDING MEMBER COUNTER
+   Update FOUNDER_SPOTS_TAKEN after each signup, then commit + push.
+   ------------------------------------------------------------------ */
+const FOUNDER_SPOTS_TOTAL = 10;
+const FOUNDER_SPOTS_TAKEN = 0;
+
+(function () {
+  const left = Math.max(0, FOUNDER_SPOTS_TOTAL - FOUNDER_SPOTS_TAKEN);
+  const num = document.getElementById("founderSpots");
+  const label = document.getElementById("founderSpotsLabel");
+  const bar = document.getElementById("founderBar");
+  const counter = document.getElementById("founderCounter");
+  if (!num) return;
+
+  if (left === 0) {
+    counter.classList.add("is-closed");
+    num.textContent = "FULL";
+    label.textContent = "Founding spots gone";
+    bar.style.width = "0%";
+    document.querySelectorAll(".plan-founder").forEach((el) => { el.style.display = "none"; });
+    return;
+  }
+
+  label.textContent = left === 1 ? "Spot Left" : "Spots Left";
+  let step = 0;
+  const timer = setInterval(() => {
+    step++;
+    num.textContent = Math.min(step, left);
+    if (step >= left) {
+      clearInterval(timer);
+      bar.style.width = `${(left / FOUNDER_SPOTS_TOTAL) * 100}%`;
+    }
+  }, 90);
+})();
+
 </script>
   </body>
 </html>
