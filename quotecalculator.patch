+/* ------------------------------------------------------------------
+   INSTANT QUOTE CALCULATOR
+   Base rates below are the only numbers you need to edit to reprice.
+   ------------------------------------------------------------------ */
+(function () {
+  const root = document.getElementById("quote");
+  if (!root) return;
+
+  const KYD_TO_USD = 1.2;
+  const BASE_FEE = 1;
+  const PER_KM = 1.5;
+  const SIZE_ADD = { small: 0, medium: 5, large: 10, oversized: 25 };
+  const URGENCY_MULT = { nextday: 1.0, sameday: 1.3, rush: 2.0 };
+  const TIME_ADD = { standard: 0, afterhours: 15, sunday: 25 };
+  const MEMBERSHIP_KYD = 179.99;
+
+  const state = {
+    currency: "KYD",
+    distance: 10,
+    size: "small",
+    urgency: "nextday",
+    time: "standard",
+    packages: 1
+  };
+
+  const el = {
+    distance: document.getElementById("quoteDistance"),
+    distanceOut: document.getElementById("quoteDistanceOut"),
+    packages: document.getElementById("quotePackages"),
+    packagesLabel: document.getElementById("quotePackagesLabel"),
+    symbol: document.getElementById("quoteSymbol"),
+    amount: document.getElementById("quoteAmount"),
+    totalNote: document.getElementById("quoteTotalNote"),
+    upsell: document.getElementById("quoteUpsell"),
+    monthly: document.getElementById("quoteMonthly"),
+    book: document.getElementById("quoteBook")
+  };
+
+  const URGENCY_TEXT = {
+    nextday: "Next-day scheduled",
+    sameday: "Same-day route",
+    rush: "Rush delivery"
+  };
+  const TIME_TEXT = { afterhours: "After-hours", sunday: "Sunday/holiday" };
+
+  function symbol() {
+    return state.currency === "USD" ? "$" : "CI$";
+  }
+
+  function money(kyd, decimals) {
+    const value = state.currency === "USD" ? kyd * KYD_TO_USD : kyd;
+    return value.toFixed(decimals === undefined ? 2 : decimals);
+  }
+
+  function pressGroup(attr, value) {
+    root.querySelectorAll("[data-" + attr + "]").forEach((btn) => {
+      btn.setAttribute("aria-pressed", String(btn.dataset[attr] === value));
+    });
+  }
+
+  function render() {
+    const perPackage =
+      (BASE_FEE + state.distance * PER_KM + SIZE_ADD[state.size]) *
+        URGENCY_MULT[state.urgency] +
+      TIME_ADD[state.time];
+    const totalKyd = Math.round(perPackage * state.packages);
+
+    el.distanceOut.textContent = state.distance;
+    el.packages.textContent = state.packages;
+    el.packagesLabel.textContent = state.packages === 1 ? "package" : "packages";
+    el.symbol.textContent = symbol();
+    el.amount.textContent = money(totalKyd, 0);
+    el.totalNote.textContent =
+      state.packages > 1
+        ? "Total for " + state.packages + " packages"
+        : "All-in price — no hidden fees";
+
+    const monthlyIfWeekly = totalKyd * 4;
+    const showUpsell = monthlyIfWeekly > MEMBERSHIP_KYD;
+    el.upsell.hidden = !showUpsell;
+    if (showUpsell) {
+      el.monthly.textContent = symbol() + money(monthlyIfWeekly, 0);
+    }
+
+    const lines = [
+      "Hi Quick Runs! I'd like to book a delivery.",
+      "",
+      state.packages +
+        (state.packages > 1 ? " packages" : " package") +
+        " · " +
+        state.distance +
+        "km",
+      "Size: " + state.size,
+      "Urgency: " + URGENCY_TEXT[state.urgency]
+    ];
+    if (state.time !== "standard") lines.push("Timing: " + TIME_TEXT[state.time]);
+    lines.push("Quote: " + symbol() + money(totalKyd, 2));
+    lines.push("");
+    lines.push("Ready to book — please advise on next steps.");
+
+    el.book.href =
+      "https://api.whatsapp.com/send?phone=13453274460&text=" +
+      encodeURIComponent(lines.join("\n"));
+  }
+
+  el.distance.addEventListener("input", () => {
+    state.distance = parseInt(el.distance.value, 10);
+    render();
+  });
+
+  root.querySelectorAll("[data-currency]").forEach((btn) => {
+    btn.addEventListener("click", () => {
+      state.currency = btn.dataset.currency;
+      pressGroup("currency", state.currency);
+      render();
+    });
+  });
+
+  ["size", "urgency", "time"].forEach((key) => {
+    root.querySelectorAll("[data-" + key + "]").forEach((btn) => {
+      btn.addEventListener("click", () => {
+        state[key] = btn.dataset[key];
+        pressGroup(key, state[key]);
+        render();
+      });
+    });
+  });
+
+  document.getElementById("quoteMinus").addEventListener("click", () => {
+    state.packages = Math.max(1, state.packages - 1);
+    render();
+  });
+  document.getElementById("quotePlus").addEventListener("click", () => {
+    state.packages = Math.min(50, state.packages + 1);
+    render();
+  });
+
+  render();
+})();
+
 </script>
   </body>
 </html>
